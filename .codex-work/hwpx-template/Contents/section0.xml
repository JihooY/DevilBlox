subList id="" textDirection="HORIZONTAL" lineWrap="BREAK" vertAlign="CENTER" linkListIDRef="0" linkListNextIDRef="0" textWidth="0" textHeight="0" hasTextRef="0" hasNumRef="0"><hp:p id="2147483648" paraPrIDRef="38" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>신청서</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="38" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>작성</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="38" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>요령</hp:t></hp:run></hp:p></hp:subList><hp:cellAddr colAddr="0" rowAddr="3"/><hp:cellSpan colSpan="1" rowSpan="1"/><hp:cellSz width="5241" height="10744"/><hp:cellMargin left="510" right="510" top="141" bottom="141"/></hp:tc><hp:tc name="" header="0" hasMargin="0" protect="0" editable="0" dirty="0" borderFillIDRef="10"><hp:subList id="" textDirection="HORIZONTAL" lineWrap="BREAK" vertAlign="CENTER" linkListIDRef="0" linkListNextIDRef="0" textWidth="0" textHeight="0" hasTextRef="0" hasNumRef="0"><hp:p id="2147483648" paraPrIDRef="36" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>1. 아이디어명: 제안 아이디어를 함축적으로 표현 (20자 이내로 권장)</hp:t></hp:run></hp:p><hp:p id="2147483648" paraPrIDRef="46" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>2. 참가구분: 예비창업자, 신규창업자</hp:t></hp:run><hp:run charPrIDRef="10"><hp:t> 중 체크, 팀 인원은 </hp:t></hp:run><hp:run charPrIDRef="29"><hp:t>팀장을 포함한 인원 수</hp:t></hp:run><hp:run charPrIDRef="10"><hp:t> 기재</hp:t></hp:run></hp:p><hp:p id="2147483648" paraPrIDRef="48" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>3. 신청자 및 서명: 팀장을 신청인으로 함</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>4. 신청서 내 빈칸 없이 모두 기재할 것</hp:t></hp:run></hp:p></hp:subList><hp:cellAddr colAddr="1" rowAddr="3"/><hp:cellSpan colSpan="1" rowSpan="1"/><hp:cellSz width="45494" height="10744"/><hp:cellMargin left="510" right="510" top="141" bottom="141"/></hp:tc></hp:tr><hp:tr><hp:tc name="" header="0" hasMargin="0" protect="0" editable="0" dirty="0" borderFillIDRef="16"><hp:subList id="" textDirection="HORIZONTAL" lineWrap="BREAK" vertAlign="CENTER" linkListIDRef="0" linkListNextIDRef="0" textWidth="0" textHeight="0" hasTextRef="0" hasNumRef="0"><hp:p id="0" paraPrIDRef="38" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>제안서</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="38" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>작성</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="38" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>요령</hp:t></hp:run></hp:p></hp:subList><hp:cellAddr colAddr="0" rowAddr="4"/><hp:cellSpan colSpan="1" rowSpan="1"/><hp:cellSz width="5241" height="29094"/><hp:cellMargin left="510" right="510" top="141" bottom="141"/></hp:tc><hp:tc name="" header="0" hasMargin="0" protect="0" editable="0" dirty="0" borderFillIDRef="10"><hp:subList id="" textDirection="HORIZONTAL" lineWrap="BREAK" vertAlign="CENTER" linkListIDRef="0" linkListNextIDRef="0" textWidth="0" textHeight="0" hasTextRef="0" hasNumRef="0"><hp:p id="0" paraPrIDRef="47" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>1. 아이디어 제안서는 주어진 항목 예시를 참고하여 자유롭게 작성</hp:t></hp:run></hp:p><hp:p id="2147483648" paraPrIDRef="36" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>2. 아이디어 내용에 따라 기본 항목 외에 항목을 추가하여 작성 가능</hp:t></hp:run></hp:p><hp:p id="2147483648" paraPrIDRef="36" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>3. 최대한 아이디어를 부각시킬 수 있도록 작성</hp:t></hp:run></hp:p><hp:p id="2147483648" paraPrIDRef="50" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>4. 객관적 자료 및 수치에 근거하여 논지를 전개</hp:t></hp:run></hp:p><hp:p id="2147483648" paraPrIDRef="36" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>5. </hp:t></hp:run><hp:run charPrIDRef="9"><hp:t>아이디어 제안서는 표지 제외 5페이지 </hp:t><hp:ctrl><hp:pageHiding hideHeader="0" hideFooter="0" hideMasterPage="0" hideBorder="0" hideFill="0" hidePageNum="1"/></hp:ctrl><hp:t>이내로 작성할 것</hp:t></hp:run></hp:p><hp:p id="2147483648" paraPrIDRef="36" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>6. 제출 시 파일 형태</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="39" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t> - 파일명은 ‘</hp:t></hp:run><hp:run charPrIDRef="30"><hp:t>2026 AI 창업 경진대회_팀명_팀장명’</hp:t></hp:run><hp:run charPrIDRef="7"><hp:t>으로 작성</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="39" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>    *예) </hp:t></hp:run><hp:run charPrIDRef="31"><hp:t>2026 AI 창업 경진대회_성장팀_홍길동</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="36" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t> - 총 파일용량은 20MByte 이내로 준수</hp:t></hp:run></hp:p><hp:p id="2147483648" paraPrIDRef="8" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t> - 서명이 필요한 참가신청서, 개인정보 수집 및 이용에 관한 동의서, 참가 서약서 등은 서명 후 스캔본(PDF)으로 제출</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="16" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="7"><hp:t>  ※ 필수 제출서류(참가신청서, 아이디어 제안서, 개인정보 수집 및 이용에 관한 동의서, 참가 서약서)를 모두 제출하지 않으면 접수 불가</hp:t></hp:run></hp:p></hp:subList><hp:cellAddr colAddr="1" rowAddr="4"/><hp:cellSpan colSpan="1" rowSpan="1"/><hp:cellSz width="45494" height="29094"/><hp:cellMargin left="510" right="510" top="141" bottom="141"/></hp:tc></hp:tr><hp:tr><hp:tc name="" header="0" hasMargin="0" protect="0" editable="0" dirty="0" borderFillIDRef="17"><hp:subList id="" textDirection="HORIZO